# Copy to .env (never commit .env). Used by scripts/seed and the chain spike only.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
# Free access key from https://hub.arkiv.network (raises rate limits)
ARKIV_ACCESS_KEY=
