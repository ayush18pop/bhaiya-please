SEED_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# App (Expo public env, safe to expose)
EXPO_PUBLIC_CORE=mock
EXPO_PUBLIC_ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
EXPO_PUBLIC_TRUSTED_VERIFIERS=
