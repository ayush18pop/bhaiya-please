# Copy to .env (never commit .env). Used by scripts/seed and the chain spike only.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
# Free access key from https://hub.arkiv.network (raises rate limits)
ARKIV_ACCESS_KEY=
# Funded Tiramisu test wallet (faucet: https://hub.arkiv.network/faucet). Synthetic/test use only.
SEED_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
# GLM the seed/heartbeat/fund scripts top each wallet up to (default 0.02)
SEED_FUND_GLM=

# App (Expo public env, safe to expose)
EXPO_PUBLIC_CORE=mock
EXPO_PUBLIC_ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# The seeded demo verifier (address only, not a secret). Comma-separate to trust more verifiers.
EXPO_PUBLIC_TRUSTED_VERIFIERS=0x166efae608457303daf2af830d281922c5d6ee20
# Optional. PUBLIC once bundled: use a separate hub.arkiv.network key whose allowed Origins are
# restricted to the deploy domain. Sent as the X-API-KEY header, never in the URL.
EXPO_PUBLIC_ARKIV_ACCESS_KEY=
