{
  "expo": {
    "name": "Bhaiya Please",
    "slug": "bhaiya-please",
    "scheme": "bhaiyaplease",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-meterblack-1024.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141412",
        "foregroundImage": "./assets/brand/icon-meterblack-1024.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/icon-meterblack-48.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera to scan handoff and runner QR codes."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "While your run is active, your phone shares a rough ~150 m area that deletes itself after 2 minutes. Exact location never leaves the phone."
        }
      ],
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mark-autoyellow-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#141412",
          "dark": {
            "image": "./assets/brand/mark-autoyellow-1024.png",
            "backgroundColor": "#141412"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#141412"
  }
}
