{
  "expo": {
    "name": "Bhaiya Please",
    "slug": "bhaiya-please",
    "scheme": "bhaiyaplease",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#e2591b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera to scan handoff and runner QR codes."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "While your run is active, your phone shares a rough ~150 m area that deletes itself after 2 minutes. Exact location never leaves the phone."
        }
      ],
      "expo-image",
      "expo-font",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 180, "backgroundColor": "#e2591b", "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#12141a" } }],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
